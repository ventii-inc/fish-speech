# Fish Speech API Server Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Configuration
# =============================================================================

# API authentication key (optional - leave empty to disable auth)
FISH_API_KEY=

# Server listen address
FISH_LISTEN=0.0.0.0:8080

# =============================================================================
# Model Configuration
# =============================================================================

# Model checkpoint paths (relative to fish-speech directory)
FISH_LLAMA_CHECKPOINT=checkpoints/openaudio-s1-mini
FISH_DECODER_CHECKPOINT=checkpoints/openaudio-s1-mini/codec.pth
FISH_DECODER_CONFIG=modded_dac_vq

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log format: json (for production) or text (for development)
LOG_FORMAT=json

# =============================================================================
# Error Tracking (Sentry)
# =============================================================================

# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=

# Sentry environment name
SENTRY_ENVIRONMENT=production

# Sentry traces sample rate (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# Rate Limiting (per hour)
# =============================================================================

# Enable/disable rate limiting
RATE_LIMIT_ENABLED=true

# Requests per hour for authenticated users (with API key)
RATE_LIMIT_PER_KEY=2000

# Requests per hour for unauthenticated users (by IP)
RATE_LIMIT_PER_IP=200

# =============================================================================
# HuggingFace (for model download)
# =============================================================================

# HuggingFace token for downloading gated models
HF_TOKEN=
